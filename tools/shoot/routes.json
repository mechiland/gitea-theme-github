{
 "$comment": "Route list for tools/shoot. gitea = path on the Gitea instance (or absolute URL); github = reference URL on github.com (logged out) or null to skip. auth:false = capture logged out. {{...}} placeholders are filled by routes-from-manifest.mjs from docs/seed-manifest.json; routes still containing placeholders are skipped. states[].selectors.{gitea,github} override states[].selector per target.",
 "giteaBase": "http://localhost:3000",
 "defaultTheme": "github-auto",
 "routes": [
  {
   "id": "home",
   "gitea": "/",
   "github": null,
   "states": [
    {
     "name": "create-menu-open",
     "action": "click",
     "selectors": {
      "gitea": "#navbar .navbar-right .ui.dropdown:has(.octicon-plus)"
     },
     "clip": "#navbar .navbar-right .ui.dropdown .menu.visible, #navbar .navbar-right .ui.dropdown .menu",
     "pad": 16,
     "viewports": [
      1440
     ]
    },
    {
     "name": "avatar-menu-open",
     "action": "click",
     "selectors": {
      "gitea": "#navbar .navbar-right .ui.dropdown:has(.navbar-avatar)"
     },
     "clip": "#navbar .navbar-right .ui.dropdown .menu.visible, #navbar .navbar-right .ui.dropdown .menu",
     "pad": 16,
     "viewports": [
      1440
     ]
    },
    {
     "name": "mobile-menu-open",
     "action": "click",
     "viewports": [
      390
     ],
     "selectors": {
      "gitea": "#navbar-expand-toggle"
     },
     "clip": "#navbar",
     "pad": 0
    }
   ]
  },
  {
   "id": "explore-repos",
   "gitea": "/explore/repos",
   "github": "https://github.com/explore",
   "states": [
    {
     "name": "search-focus",
     "action": "focus",
     "selectors": {
      "gitea": ".page-content input[name=q]",
      "github": "header input, header button[aria-label*=Search i], .header-search-button"
     }
    },
    {
     "name": "sort-open",
     "action": "click",
     "selectors": {
      "gitea": ".page-content form .item.ui.small.dropdown:has-text('Sort')"
     },
     "clip": ".page-content form .ui.dropdown .menu.visible",
     "pad": 16
    }
   ]
  },
  {
   "id": "explore-users",
   "gitea": "/explore/users",
   "github": null
  },
  {
   "id": "explore-orgs",
   "gitea": "/explore/organizations",
   "github": null
  },
  {
   "id": "login",
   "gitea": "/user/login",
   "github": "https://github.com/login",
   "auth": false,
   "states": [
    {
     "name": "input-focus",
     "action": "focus",
     "selectors": {
      "gitea": "#user_name",
      "github": "#login_field"
     }
    },
    {
     "name": "primary-hover",
     "action": "hover",
     "selectors": {
      "gitea": "form button.ui.primary.button",
      "github": "input[type=submit][name=commit]"
     }
    },
    {
     "name": "primary-press",
     "action": "press",
     "selectors": {
      "gitea": "form button.ui.primary.button",
      "github": "input[type=submit][name=commit]"
     }
    },
    {
     "name": "primary-focus",
     "action": "focus",
     "selectors": {
      "gitea": "form button.ui.primary.button",
      "github": "input[type=submit][name=commit]"
     }
    },
    {
     "name": "primary-disabled",
     "action": "disable",
     "selectors": {
      "gitea": "form button.ui.primary.button",
      "github": "input[type=submit][name=commit]"
     }
    },
    {
     "name": "validation-error",
     "action": "submitEmpty",
     "selectors": {
      "gitea": "form[action*='/user/login']"
     },
     "clip": "main, .page-content, [role=main]"
    }
   ]
  },
  {
   "id": "signup",
   "gitea": "/user/sign_up",
   "github": "https://github.com/signup",
   "auth": false,
   "states": [
    {
     "name": "validation-error",
     "action": "submitEmpty",
     "selectors": {
      "gitea": "form[action*='/user/sign_up']"
     },
     "clip": ".page-content"
    }
   ]
  },
  {
   "id": "user-profile",
   "gitea": "/alice-dev",
   "github": "https://github.com/pemistahl"
  },
  {
   "id": "site-admin",
   "gitea": "/-/admin",
   "github": null
  },
  {
