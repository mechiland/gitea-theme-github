   "gitea": "/user/settings/appearance",
   "github": null,
   "states": [
    {
     "name": "theme-dropdown-open",
     "action": "click",
     "selectors": {
      "gitea": "form[action$='/theme'] .ui.selection.dropdown"
     },
     "clip": "form[action$='/theme']",
     "pad": 16
    }
   ]
  },
  {
   "id": "user-settings-keys",
   "gitea": "/user/settings/keys",
   "github": null,
   "states": [
    {
     "name": "add-key-panel",
     "action": "click",
     "selectors": {
      "gitea": "button.show-panel.toggle[data-panel='#add-ssh-key-panel'], .user-setting-content button.show-panel"
     },
     "clip": ".user-setting-content",
     "pad": 0
    }
   ]
  },
  {
   "id": "notifications",
   "gitea": "/notifications",
   "github": null
  },
  {
   "id": "repo-home",
   "gitea": "/octo-org/grex",
   "github": "https://github.com/pemistahl/grex",
   "states": [
    {
     "name": "branch-menu-open",
     "action": "click",
     "selectors": {
      "gitea": ".branch-dropdown-button",
      "github": "button[data-testid='anchor-button']:has(.octicon-git-branch), #branch-picker-repos-header-ref-selector, button:has(svg.octicon-git-branch)"
     },
     "pad": 16,
     "clips": {
      "gitea": ".branch-selector-dropdown .menu",
      "github": "[class*='prc-Overlay-Overlay'], [class*='AnchoredOverlay'], [role=dialog]"
     }
    },
    {
     "name": "code-menu-open",
     "action": "click",
     "selectors": {
      "gitea": ".repo-button-row .ui.primary.button:has(.octicon-code), .repo-home-sidebar-top .clone-panel-button, #repo-clone-panel-btn, .clone-panel-button, button:has-text('Code')",
      "github": "button:has-text('Code')"
     },
     "pad": 16,
     "clips": {
      "gitea": ".tippy-box",
      "github": "[class*='prc-Overlay-Overlay'], [class*='AnchoredOverlay'], [role=dialog]"
     }
    },
    {
     "name": "file-row-hover",
     "action": "hover",
     "selectors": {
      "gitea": "#repo-files-table .repo-file-item, #repo-files-table .repo-file-line",
      "github": "table[aria-labelledby=folders-and-files] tbody tr.react-directory-row"
     }
    },
    {
     "name": "add-file-open",
     "action": "click",
     "selectors": {
      "gitea": ".repo-button-row .repo-add-file",
      "github": "button:has-text('Add file')"
     },
     "clips": {
      "gitea": ".repo-add-file > .menu",
      "github": "[class*='prc-Overlay-Overlay']"
     },
     "pad": 16,
     "viewports": [
      1440
     ]
    },
    {
     "name": "tooltip-hover",
     "action": "hover",
     "selectors": {
      "gitea": "#navbar .navbar-right .ui.dropdown:has(.octicon-plus)",
      "github": "header button[aria-label='Search or jump to…'], header [data-target='qbsearch-input.inputButton']"
     },
     "clips": {
      "gitea": ".tippy-box[data-theme=tooltip]",
      "github": "[class*='prc-TooltipV2-Tooltip']:popover-open, [role=tooltip]:popover-open"
     },
     "pad": 24,
     "wait": 800,
     "viewports": [
      1440
     ]
    }
   ]
  },
  {
   "id": "repo-issues",
   "gitea": "/octo-org/grex/issues",
   "github": "https://github.com/pemistahl/grex/issues",
