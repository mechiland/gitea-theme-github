{{/* gitea-theme-github: Gitea 28.1.0 templates/base/head_impersonate_banner.tmpl verbatim. Shipped so the name also exists on Gitea 1.27.x: html/template refuses a page that references an undefined template even in a branch that never runs (the 28.x branches of base/head_navbar.tmpl and custom/gh_head_navbar.tmpl). Only called on 28.x. */}}{{$impersonated := ctx.ImpersonatedUser}}
{{if $impersonated}}
<div class="ui warning message site-banner-container">
	<div class="flex-text-block site-banner-content">
		{{svg "octicon-alert"}}
		<span class="tw-flex-1">{{ctx.Locale.Tr "admin.users.impersonating_notice" $impersonated.Name}}</span>
		<a class="ui compact tiny button hover-opaque" href="{{AppSubUrl}}/user/logout">{{ctx.Locale.Tr "admin.users.impersonate_stop"}}</a>
	</div>
</div>
{{end}}
